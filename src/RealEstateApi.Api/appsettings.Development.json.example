{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=realestate;Username=postgres;Password=yourpassword"
  },
  "JwtSettings": {
    "Issuer": "http://localhost:3000",
    "Audience": "http://localhost:5000",
    "SecretKey": "your-jwt-secret-key-from-better-auth-minimum-32-characters",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  }
}
